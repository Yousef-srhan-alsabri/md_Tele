APP_NAME=منصة إدارة حسابات Telegram
ENVIRONMENT=production
SECRET_KEY=generate-a-random-64-character-secret
SESSION_ENCRYPTION_KEY=generate-a-fernet-key
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/telegram_platform
TELEGRAM_API_ID=your-telegram-api-id
TELEGRAM_API_HASH=your-telegram-api-hash
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use-a-strong-password
PUBLIC_REGISTRATION=true
DEFAULT_USER_BALANCE=0
MAX_LINKS_PER_BATCH=500
MAX_ACCOUNTS_PER_USER=10
